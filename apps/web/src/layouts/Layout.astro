---
import BarraSuperior from '../components/BarraSuperior.astro';
import PiePagina from '../components/PiePagina.astro';

interface Props {
  titulo?: string;
  seccion?: 'inicio' | 'catalogo';
}

const { titulo = 'Aleación Prima', seccion } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@600;700&family=IBM+Plex+Mono:wght@500;600&family=Roboto:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
  </head>
  <body>
    <BarraSuperior seccion={seccion} />
    <main>
      <slot />
    </main>
    <PiePagina />
  </body>
</html>

<style is:global>
  :root {
    --q-primary: #c2410c;
    --q-accent: #f97316;
    --q-secondary: #334155;
    --q-dark: #0f172a;
    --ap-fondo: #f8fafc;
    --ap-superficie: #ffffff;
    --ap-borde: #e2e8f0;
    --ap-texto-secundario: #475569;
    --fuente-titulos: 'Barlow Semi Condensed', sans-serif;
    --fuente-cuerpo: Roboto, sans-serif;
    --fuente-codigo: 'IBM Plex Mono', monospace;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
  }

  body {
    background: var(--ap-fondo);
    color: var(--q-dark);
    display: flex;
    flex-direction: column;
    font-family: var(--fuente-cuerpo);
    font-size: 14px;
    line-height: 20px;
    min-height: 100vh;
  }

  main {
    flex: 1;
    width: 100%;
  }

  h1,
  h2,
  h3 {
    font-family: var(--fuente-titulos);
    margin: 0;
  }

  a {
    color: var(--q-primary);
  }
</style>
