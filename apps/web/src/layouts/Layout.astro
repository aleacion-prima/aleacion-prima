---
interface Props {
  titulo?: string;
  seccion?: 'inicio' | 'catalogo';
}

const { titulo = 'Aleación Prima', seccion } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@600;700&family=IBM+Plex+Mono:wght@600&family=Roboto:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
  </head>
  <body>
    <header class="barra">
      <a class="barra__logo" href="/">
        <img src="/logo.svg" width="28" height="28" alt="" />
        <span>ALEACIÓN PRIMA</span>
      </a>
      <nav class="barra__nav">
        <a
          href="/"
          class:list={['barra__enlace', { 'barra__enlace--activo': seccion === 'inicio' }]}
        >
          Inicio
        </a>
        <a
          href="/catalogo"
          class:list={['barra__enlace', { 'barra__enlace--activo': seccion === 'catalogo' }]}
        >
          Catálogo
        </a>
      </nav>
      <span class="barra__espacio"></span>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --ap-fondo: #f8fafc;
    --ap-superficie: #ffffff;
    --ap-borde: #e2e8f0;
    --ap-texto-secundario: #475569;
    --q-primary: #c2410c;
    --q-secondary: #334155;
    --q-accent: #f97316;
    --q-dark: #0f172a;
    --q-positive: #15803d;
    --fuente-titulos: 'Barlow Semi Condensed', sans-serif;
    --fuente-codigo: 'IBM Plex Mono', monospace;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    background: var(--ap-fondo);
    font-family: Roboto, sans-serif;
    color: var(--q-dark);
  }

  main {
    max-width: 1440px;
    margin: 0 auto;
  }

  .aviso {
    padding: 48px 32px;
    text-align: center;
    color: var(--ap-texto-secundario);
  }

  .boton {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: 0.25px;
    text-decoration: none;
    box-sizing: border-box;
  }

  .boton--contorno {
    background: var(--ap-superficie);
    border: 1px solid var(--q-secondary);
    color: var(--q-secondary);
  }

  .boton--alto {
    height: 48px;
  }

  .enlace {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--q-primary);
    text-decoration: none;
  }
</style>

<style>
  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 32px;
    background: var(--q-secondary);
  }

  .barra__logo {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 280px;
    height: 44px;
    font-family: var(--fuente-titulos);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--ap-superficie);
    text-decoration: none;
  }

  .barra__nav {
    display: flex;
    gap: 16px;
  }

  .barra__enlace {
    padding: 12px 16px 9px;
    border-bottom: 3px solid transparent;
    font-size: 20px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: 0.25px;
    color: var(--ap-superficie);
    text-decoration: none;
  }

  .barra__enlace--activo {
    border-bottom-color: var(--q-accent);
  }

  .barra__espacio {
    width: 280px;
  }

  @media (max-width: 767px) {
    .barra__logo span,
    .barra__espacio {
      display: none;
    }

    .barra__logo {
      width: auto;
    }
  }
</style>
