---
import BarraSuperior from '../components/BarraSuperior.astro';
import PiePagina from '../components/PiePagina.astro';

interface Props {
  titulo?: string;
  descripcion?: string;
  seccion?: 'inicio' | 'catalogo';
}

const {
  titulo = 'Aleación Prima',
  descripcion = 'Fundición de piezas de hierro gris y nodular en Torreón, Coahuila.',
  seccion,
} = Astro.props;
const fuentes =
  'https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@600;700&family=IBM+Plex+Mono:wght@500;600&family=Roboto:wght@400;500;600&display=swap';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fuentes} />
    <link rel="stylesheet" href={fuentes} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={fuentes} />
    </noscript>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={descripcion} />
    <title>{titulo}</title>
  </head>
  <body>
    <BarraSuperior seccion={seccion} />
    <main>
      <slot />
    </main>
    <PiePagina />
    <script>
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        new Lenis({ autoRaf: true, anchors: true, lerp: 0.09 });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ap-fondo: #f8fafc;
    --ap-superficie: #ffffff;
    --ap-borde: #e2e8f0;
    --ap-texto-secundario: #475569;
    --q-primary: #c2410c;
    --q-secondary: #334155;
    --q-accent: #f97316;
    --q-dark: #0f172a;
    --q-positive: #15803d;
    --fuente-titulos: 'Barlow Semi Condensed', sans-serif;
    --fuente-cuerpo: Roboto, sans-serif;
    --fuente-codigo: 'IBM Plex Mono', monospace;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
  }

  body {
    background: var(--ap-fondo);
    color: var(--q-dark);
    display: flex;
    flex-direction: column;
    font-family: var(--fuente-cuerpo);
    font-size: 14px;
    line-height: 20px;
    min-height: 100vh;
  }

  main {
    flex: 1;
    min-height: 100svh;
    margin: 0 auto;
    max-width: 1440px;
    width: 100%;
  }

  h1,
  h2,
  h3 {
    font-family: var(--fuente-titulos);
    margin: 0;
  }

  a {
    color: var(--q-primary);
  }

  .aviso {
    color: var(--ap-texto-secundario);
    padding: 48px 32px;
    text-align: center;
  }

  .boton {
    align-items: center;
    border-radius: 8px;
    box-sizing: border-box;
    display: flex;
    font-size: 14px;
    font-weight: 500;
    gap: 8px;
    justify-content: center;
    letter-spacing: 0.25px;
    line-height: 20px;
    min-height: 40px;
    padding: 8px 16px;
    text-decoration: none;
  }

  .boton--primario {
    background: var(--q-primary);
    color: var(--ap-superficie);
    transition: background 0.2s ease;
  }

  .boton--grande {
    min-height: 48px;
    padding: 12px 28px;
    font-size: 15px;
  }

  .boton--primario:hover {
    background: var(--q-accent);
  }

  .boton--contorno {
    background: var(--ap-superficie);
    border: 1px solid var(--q-secondary);
    color: var(--q-secondary);
  }

  .boton--alto {
    height: 48px;
  }

  .boton:focus-visible,
  .volver:focus-visible {
    outline: 2px solid var(--q-accent);
    outline-offset: 3px;
  }

  .banda-oscura {
    box-shadow: 0 0 0 100vmax var(--q-dark);
    clip-path: inset(0 -100vmax);
    background: var(--q-dark);
    color: var(--ap-superficie);
  }

  .volver {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: -6px;
    font-size: 14px;
    font-weight: 500;
    color: #cbd5e1;
    text-decoration: none;
  }

  .volver:hover {
    color: var(--ap-superficie);
  }

  .mascara {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .mascara > span {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mascara > span {
      animation: subir-mascara 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.1s backwards;
    }
  }

  @keyframes subir-mascara {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .enlace {
    align-items: center;
    color: var(--q-primary);
    display: inline-flex;
    font-size: 14px;
    font-weight: 500;
    gap: 8px;
    padding: 8px 16px;
    text-decoration: none;
  }
</style>
