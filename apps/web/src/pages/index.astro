---
import CifrasPlanta from '../components/inicio/CifrasPlanta.astro';
import FichaLote from '../components/inicio/FichaLote.astro';
import MaterialesHierro from '../components/inicio/MaterialesHierro.astro';
import ProcesoFundicion from '../components/inicio/ProcesoFundicion.astro';
import ProductosDestacados from '../components/inicio/ProductosDestacados.vue';
import SobreFabrica from '../components/inicio/SobreFabrica.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Aleación Prima" seccion="inicio">
  <script is:inline>
    document.documentElement.classList.add('con-animaciones');
  </script>
  <section class="portada">
    <div class="portada__texto">
      <img class="portada__logo" src="/logo.svg" width="64" height="64" alt="" />
      <h1>Piezas de hierro gris y nodular, trazadas lote por lote</h1>
      <p>
        Fundimos en Torreón, Coahuila, piezas en bruto para refaccionarias, fabricantes de
        maquinaria agrícola y talleres. Cada colada queda registrada de la arena a la entrega.
      </p>
      <div class="portada__acciones">
        <a class="boton portada__boton" href="/catalogo">
          Ver catálogo
        </a>
        <a class="enlace portada__enlace" href="#proceso">
          Cómo fabricamos
        </a>
      </div>
    </div>
    <div class="portada__ficha">
      <FichaLote />
    </div>
  </section>

  <CifrasPlanta />

  <section class="bloque">
    <header class="bloque__encabezado" data-revelar>
      <div>
        <h2>Nuestros productos</h2>
        <p>Primero los que tenemos en existencia.</p>
      </div>
      <a class="enlace" href="/catalogo">
        Ver todo el catálogo
      </a>
    </header>
    <ProductosDestacados client:load />
  </section>

  <ProcesoFundicion />

  <MaterialesHierro />

  <SobreFabrica />

  <section class="llamado">
    <div class="llamado__contenido" data-revelar>
      <div>
        <h2>¿Buscas una pieza de fundición?</h2>
        <p>Revisa la disponibilidad de cada pieza en el catálogo.</p>
      </div>
      <a class="boton llamado__boton" href="/catalogo">
        Ver catálogo
      </a>
    </div>
  </section>
</Layout>

<script>
  const contar = (elemento: HTMLElement): void => {
    const final = Number(elemento.dataset.contar);
    const inicio = performance.now();
    const paso = (ahora: number): void => {
      const avance = Math.min((ahora - inicio) / 1200, 1);
      elemento.textContent = String(Math.round(final * (1 - Math.pow(1 - avance, 3))));
      if (avance < 1) requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);
  };

  const animar = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const observador = new IntersectionObserver(
    (entradas) => {
      for (const entrada of entradas) {
        if (!entrada.isIntersecting) continue;
        entrada.target.classList.add('revelado');
        if (animar) {
          entrada.target.querySelectorAll<HTMLElement>('[data-contar]').forEach(contar);
        }
        observador.unobserve(entrada.target);
      }
    },
    { threshold: 0.2 },
  );
  document.querySelectorAll('[data-revelar]').forEach((elemento) => observador.observe(elemento));
</script>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  .bloque {
    padding: 72px 32px;
  }

  .bloque__encabezado {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 32px;
  }

  .bloque__encabezado h2 {
    margin: 0;
    padding-left: 14px;
    border-left: 4px solid var(--q-primary);
    font-family: var(--fuente-titulos);
    font-size: 32px;
    font-weight: 700;
    line-height: 36px;
    text-transform: uppercase;
  }

  .bloque__encabezado p {
    margin: 8px 0 0 18px;
    font-size: 15px;
    line-height: 22px;
    color: var(--ap-texto-secundario);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .con-animaciones [data-revelar] {
      opacity: 0;
      translate: 0 20px;
      transition:
        opacity 0.6s ease calc(var(--i, 0) * 80ms),
        translate 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i, 0) * 80ms);
    }

    .con-animaciones [data-revelar].revelado {
      opacity: 1;
      translate: none;
    }
  }

  @media (max-width: 599px) {
    .bloque {
      padding: 56px 16px;
    }

    .bloque__encabezado {
      flex-direction: column;
      align-items: flex-start;
    }

    .bloque__encabezado h2 {
      font-size: 26px;
      line-height: 30px;
    }
  }
</style>

<style>
  .portada {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
    padding: 72px 32px 80px;
    background: var(--q-dark);
    color: var(--ap-superficie);
  }

  .portada__texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 600px;
  }

  .portada__logo {
    width: 64px;
    height: 64px;
  }

  h1 {
    margin: 0;
    font-family: var(--fuente-titulos);
    font-size: clamp(38px, 5vw, 60px);
    font-weight: 700;
    line-height: 1.02;
    text-transform: uppercase;
  }

  .portada p {
    max-width: 520px;
    margin: 0;
    font-size: 17px;
    line-height: 26px;
    color: #cbd5e1;
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }

  .portada__boton,
  .llamado__boton {
    min-height: 48px;
    padding: 12px 28px;
    font-size: 15px;
    background: var(--q-primary);
    color: var(--ap-superficie);
    transition: background 0.2s ease;
  }

  .portada__boton:hover {
    background: var(--q-accent);
  }

  .portada__enlace {
    color: var(--ap-superficie);
    text-decoration: underline;
    text-decoration-color: rgb(248 250 252 / 35%);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s ease;
  }

  .portada__enlace:hover {
    text-decoration-color: var(--q-accent);
  }

  .portada__boton:focus-visible,
  .portada__enlace:focus-visible,
  .llamado__boton:focus-visible {
    outline: 2px solid var(--q-accent);
    outline-offset: 3px;
  }

  .portada__ficha {
    max-width: 480px;
    width: 100%;
    justify-self: end;
  }

  .llamado {
    padding: 56px 32px;
    background: var(--q-primary);
    color: var(--ap-superficie);
  }

  .llamado__contenido {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .llamado h2 {
    margin: 0;
    font-family: var(--fuente-titulos);
    font-size: 32px;
    font-weight: 700;
    line-height: 36px;
    text-transform: uppercase;
  }

  .llamado p {
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 24px;
    color: #ffedd5;
  }

  .llamado__boton {
    flex-shrink: 0;
    background: var(--q-dark);
  }

  .llamado__boton:hover {
    background: var(--q-secondary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .portada__texto > * {
      animation: entrar 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    }

    .portada__texto > :nth-child(2) {
      animation-delay: 0.08s;
    }

    .portada__texto > :nth-child(3) {
      animation-delay: 0.16s;
    }

    .portada__texto > :nth-child(4) {
      animation-delay: 0.24s;
    }

    .portada__ficha {
      animation: entrar 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s backwards;
    }
  }

  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @media (max-width: 1023px) {
    .portada {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .portada__ficha {
      justify-self: start;
    }
  }

  @media (max-width: 599px) {
    .portada {
      padding: 48px 16px 56px;
    }

    .llamado {
      padding: 48px 16px;
    }

    .llamado__contenido {
      flex-direction: column;
      align-items: flex-start;
    }

    .llamado h2 {
      font-size: 26px;
      line-height: 30px;
    }
  }
</style>
