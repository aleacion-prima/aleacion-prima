---
import EstadoWebsocket from '../components/EstadoWebsocket.vue';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="hero">
    <p class="eyebrow">Fundición y manufactura metalúrgica</p>
    <h1>Componentes confiables para la industria.</h1>
    <p>Conoce nuestros productos y solicita una cotización con el equipo de ventas.</p>
    <a class="boton" href="/cotizar">
      Cotizar
    </a>
  </section>
  <EstadoWebsocket client:load />
</Layout>

<style>
  .hero {
    max-width: 700px;
    padding: 8rem 0;
  }

  .eyebrow {
    color: #176b87;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.5rem, 8vw, 5rem);
    line-height: 1;
    margin: 1rem 0;
  }

  p {
    color: #5d6873;
    font-size: 1.2rem;
    line-height: 1.6;
  }

  .boton {
    background: #176b87;
    border-radius: 0.4rem;
    color: white;
    display: inline-block;
    font-weight: 700;
    margin-top: 1rem;
    padding: 0.8rem 1.5rem;
    text-decoration: none;
  }
</style>
