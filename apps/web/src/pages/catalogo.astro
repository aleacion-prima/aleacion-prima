---
import CatalogoProductos from '../components/catalogo/CatalogoProductos.vue';
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Catálogo · Aleación Prima" seccion="catalogo">
  <section class="encabezado">
    <a class="encabezado__volver" href="/">
      <img src="/iconos/chevron-left.svg" width="20" height="20" alt="" />
      Inicio
    </a>
    <h1>
      <span class="mascara">
        <span>Catálogo de productos</span>
      </span>
    </h1>
    <p>
      Piezas de fundición en bruto de hierro gris y nodular. La existencia se actualiza en vivo
      desde la planta.
    </p>
  </section>
  <section class="productos">
    <CatalogoProductos client:load />
  </section>
</Layout>

<style>
  .encabezado {
    box-shadow: 0 0 0 100vmax var(--q-dark);
    clip-path: inset(0 -100vmax);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 40px 32px 48px;
    background: var(--q-dark);
    color: var(--ap-superficie);
  }

  .encabezado__volver {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: -6px;
    font-size: 14px;
    font-weight: 500;
    color: #cbd5e1;
    text-decoration: none;
  }

  .encabezado__volver:hover {
    color: var(--ap-superficie);
  }

  h1 {
    margin: 8px 0 0;
    font-family: var(--fuente-titulos);
    font-size: clamp(34px, 4.5vw, 52px);
    font-weight: 700;
    line-height: 1.05;
    text-transform: uppercase;
  }

  p {
    max-width: 560px;
    margin: 0;
    font-size: 16px;
    line-height: 24px;
    color: #cbd5e1;
  }

  .productos {
    padding: 40px 32px 72px;
  }

  .mascara {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .mascara > span {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mascara > span {
      animation: subir-mascara 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.1s backwards;
    }

    .encabezado__volver,
    .encabezado p {
      animation: entrar 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s backwards;
    }

    @supports (animation-timeline: view()) {
      .encabezado h1 {
        animation: alejarse linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }

  @keyframes subir-mascara {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @keyframes alejarse {
    to {
      opacity: 0.3;
      translate: 0 -60px;
    }
  }

  @media (max-width: 599px) {
    .encabezado {
      padding: 32px 16px 40px;
    }

    .productos {
      padding: 32px 16px 56px;
    }
  }
</style>
