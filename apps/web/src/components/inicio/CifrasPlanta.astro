---
const cifras = [
  { numero: 750, unidad: 'kg', texto: 'de metal por colada' },
  { numero: 6, unidad: '', texto: 'etapas de proceso por lote' },
  { numero: 2, unidad: '', texto: 'tipos de hierro: gris y nodular' },
  { numero: 20, unidad: '', texto: 'personas en un turno' },
];
---

<section class="cifras" data-revelar>
  {cifras.map(({ numero, unidad, texto }) => (
    <div class="cifra">
      <strong>
        <span data-contar={numero}>{numero}</span>
        {unidad && <small>{unidad}</small>}
      </strong>
      <span class="cifra__texto">{texto}</span>
    </div>
  ))}
</section>

<style>
  .cifras {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    background: var(--ap-superficie);
    border-bottom: 1px solid var(--ap-borde);
  }

  .cifra {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 28px 32px;
  }

  .cifra + .cifra {
    border-left: 1px solid var(--ap-borde);
  }

  strong {
    display: flex;
    align-items: baseline;
    gap: 4px;
    font-family: var(--fuente-titulos);
    font-size: 44px;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  small {
    font-size: 22px;
    color: var(--ap-texto-secundario);
  }

  .cifra__texto {
    font-size: 14px;
    line-height: 20px;
    color: var(--ap-texto-secundario);
  }

  @media (max-width: 767px) {
    .cifras {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cifra {
      padding: 20px 16px;
    }

    .cifra:nth-child(3) {
      border-left: 0;
    }

    .cifra:nth-child(n + 3) {
      border-top: 1px solid var(--ap-borde);
    }

    strong {
      font-size: 36px;
    }
  }
</style>
