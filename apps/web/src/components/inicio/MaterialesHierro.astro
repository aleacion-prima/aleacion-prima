---
const materiales = [
  {
    nombre: 'Hierro gris',
    grado: 'Clase 30 · ASTM A48',
    texto: 'Grafito laminar. Buena absorción de vibraciones y disipación de calor.',
    piezas: ['Discos de freno', 'Poleas industriales'],
  },
  {
    nombre: 'Hierro nodular',
    grado: '65-45-12 y 80-55-06 · ASTM A536',
    texto: 'Grafito esferoidal. Mayor resistencia y ductilidad para servicio pesado.',
    piezas: ['Cajas de transmisión', 'Carcasas de precisión', 'Soportes de mangueta agrícola'],
  },
];
---

<section class="materiales">
  <h2 data-revelar>Materiales</h2>
  <div class="materiales__lista">
    {materiales.map(({ nombre, grado, texto, piezas }, i) => (
      <article class="material" data-revelar style={`--i: ${i}`}>
        <h3>{nombre}</h3>
        <span class="material__grado">{grado}</span>
        <p>{texto}</p>
        <ul>
          {piezas.map((pieza) => (
            <li>{pieza}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .materiales {
    padding: 0 32px 40px;
  }

  h2 {
    margin: 0 0 24px;
    font-family: var(--fuente-titulos);
    font-size: 28px;
    font-weight: 600;
    line-height: 32px;
    text-align: center;
  }

  .materiales__lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .material {
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    background: var(--ap-superficie);
    border: 1px solid var(--ap-borde);
    border-top: 4px solid var(--q-primary);
    border-radius: 12px;
  }

  .material:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgb(15 23 42 / 10%);
  }

  h3 {
    margin: 0;
    font-family: var(--fuente-titulos);
    font-size: 20px;
    font-weight: 600;
    line-height: 24px;
  }

  .material__grado {
    font-family: var(--fuente-codigo);
    font-size: 13px;
    font-weight: 600;
    color: var(--q-primary);
  }

  p {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--ap-texto-secundario);
  }

  ul {
    margin: 0;
    padding-left: 20px;
    font-size: 14px;
    line-height: 22px;
  }

  @media (max-width: 767px) {
    .materiales__lista {
      grid-template-columns: 1fr;
    }
  }
</style>
