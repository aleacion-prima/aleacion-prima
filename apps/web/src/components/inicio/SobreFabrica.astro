---
import EncabezadoBloque from './EncabezadoBloque.astro';

const datos = [
  { clave: 'Clientes', valor: 'Refaccionarias de autopartes' },
  { clave: '', valor: 'Fabricantes de maquinaria agrícola' },
  { clave: '', valor: 'Talleres de la Comarca Lagunera' },
  { clave: 'Equipo', valor: 'Unas 20 personas en un turno' },
  { clave: 'Laboratorio', valor: 'Durómetro Brinell, espectrómetro y ultrasonido' },
  { clave: 'Ubicación', valor: 'Torreón, Coahuila' },
  { clave: 'Horario', valor: 'Lunes a viernes, 07:00 a 17:00' },
];
---

<section class="bloque">
  <EncabezadoBloque
    numero="04"
    titulo="La planta"
    texto="Fundimos piezas en bruto, sin maquinar, para empresas. No vendemos al público en general."
  />
  <div class="planta">
    <dl class="planta__datos" data-revelar>
      {datos.map(({ clave, valor }) => (
        <div>
          <dt>{clave}</dt>
          <dd>{valor}</dd>
        </div>
      ))}
    </dl>
    <div class="planta__mapa" data-revelar style="--i: 1">
      <iframe
        title="Ubicación de la planta en Torreón, Coahuila"
        data-mapa="https://www.openstreetmap.org/export/embed.html?bbox=-103.47%2C25.50%2C-103.36%2C25.58&layer=mapnik&marker=25.5428%2C-103.4068"
      ></iframe>
    </div>
  </div>
</section>

<script>
  const mapa = document.querySelector<HTMLIFrameElement>('[data-mapa]');

  if (mapa) {
    const observador = new IntersectionObserver(
      ([entrada]) => {
        if (!entrada?.isIntersecting) return;
        mapa.src = mapa.dataset.mapa ?? '';
        observador.disconnect();
      },
      { rootMargin: '400px 0px' },
    );
    observador.observe(mapa);
  }
</script>

<style>
  .planta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    border-bottom: 1px solid var(--q-dark);
  }

  .planta__datos {
    margin: 0;
    border-right: 1px solid var(--q-dark);
  }

  .planta__datos div {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 24px 14px 0;
    border-bottom: 1px solid #cbd5e1;
  }

  .planta__datos div:last-child {
    border-bottom: 0;
  }

  dt {
    padding-left: 20px;
    font-size: 13px;
    color: var(--ap-texto-secundario);
  }

  dd {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 20px;
  }

  .planta__mapa {
    min-height: 380px;
    background: var(--ap-borde);
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 380px;
    border: 0;
  }

  @media (max-width: 899px) {
    .planta {
      grid-template-columns: 1fr;
    }

    .planta__datos {
      border-right: 0;
      border-bottom: 1px solid var(--q-dark);
    }

    .planta__datos div {
      grid-template-columns: 88px minmax(0, 1fr);
    }

    dt {
      padding-left: 12px;
    }
  }
</style>
