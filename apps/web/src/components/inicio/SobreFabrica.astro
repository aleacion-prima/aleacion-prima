---
const sectores = [
  'Refaccionarias de autopartes',
  'Fabricantes de maquinaria agrícola',
  'Talleres de la Comarca Lagunera',
];
---

<section class="bloque fabrica">
  <div class="fabrica__info" data-revelar>
    <h2>Sobre la fábrica</h2>
    <p>
      Fabricamos piezas de hierro gris y nodular para los sectores automotriz, agrícola e
      industrial. Cada lote se registra y se puede rastrear en todas sus etapas.
    </p>
    <h3>A quién atendemos</h3>
    <ul>
      {sectores.map((sector) => (
        <li>{sector}</li>
      ))}
    </ul>
    <dl>
      <div>
        <dt>Ubicación</dt>
        <dd>Torreón, Coahuila</dd>
      </div>
      <div>
        <dt>Horario</dt>
        <dd>Lunes a viernes, 07:00 a 17:00</dd>
      </div>
    </dl>
  </div>
  <div class="fabrica__mapa" data-revelar style="--i: 1">
    <iframe
      title="Ubicación de la planta en Torreón, Coahuila"
      src="https://www.openstreetmap.org/export/embed.html?bbox=-103.47%2C25.50%2C-103.36%2C25.58&layer=mapnik&marker=25.5428%2C-103.4068"
      loading="lazy"
    ></iframe>
  </div>
</section>

<style>
  .fabrica {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    padding-top: 0;
  }

  .fabrica__info {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px;
    background: var(--ap-superficie);
    border: 1px solid var(--ap-borde);
    border-radius: 12px;
  }

  h2,
  h3 {
    margin: 0;
    font-family: var(--fuente-titulos);
    font-weight: 600;
  }

  h2 {
    padding-left: 14px;
    border-left: 4px solid var(--q-primary);
    font-size: 28px;
    font-weight: 700;
    line-height: 32px;
    text-transform: uppercase;
  }

  h3 {
    margin-top: 8px;
    font-size: 16px;
    line-height: 20px;
  }

  p {
    margin: 0;
    font-size: 15px;
    line-height: 22px;
    color: var(--ap-texto-secundario);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ap-texto-secundario);
  }

  li::before {
    content: '';
    width: 3px;
    height: 18px;
    flex-shrink: 0;
    background: var(--q-accent);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: auto 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--ap-borde);
  }

  dt {
    font-size: 12px;
    font-weight: 500;
    color: var(--ap-texto-secundario);
  }

  dd {
    margin: 4px 0 0;
    font-size: 14px;
    font-weight: 500;
  }

  .fabrica__mapa {
    overflow: hidden;
    min-height: 360px;
    border: 1px solid var(--ap-borde);
    border-radius: 12px;
    background: var(--ap-borde);
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 360px;
    border: 0;
  }

  @media (max-width: 767px) {
    .fabrica {
      grid-template-columns: 1fr;
    }

    .fabrica__info {
      padding: 24px;
    }
  }
</style>
