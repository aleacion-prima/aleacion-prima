---
const etapas = [
  { codigo: 'MOL', area: 'Moldeo', fecha: '24 sep 07:00', recibidas: 50, entregadas: 50 },
  { codigo: 'FUS', area: 'Fusión', fecha: '24 sep 10:30', recibidas: 50, entregadas: 50 },
  { codigo: 'COL', area: 'Colada', fecha: '24 sep 12:30', recibidas: 50, entregadas: 50 },
  { codigo: 'DES', area: 'Desmolde', fecha: '25 sep 07:00', recibidas: 50, entregadas: 48 },
  { codigo: 'GRA', area: 'Granallado', fecha: '25 sep 08:30', recibidas: 48, entregadas: 47 },
  { codigo: 'CAL', area: 'Calidad', fecha: '25 sep 10:30', recibidas: 47, entregadas: 46 },
];
---

<figure class="ficha" data-ficha aria-label="Registro real de un lote terminado">
  <header class="ficha__encabezado">
    <div>
      <span class="ficha__codigo">LOT-20260924-01</span>
      <span class="ficha__producto">Disco de freno · 50 piezas</span>
    </div>
    <span class="ficha__estado" data-ficha-estado>
      Terminado
    </span>
  </header>

  <div class="ficha__avance" aria-hidden="true">
    <span></span>
  </div>

  <ol class="ficha__etapas">
    {etapas.map(({ codigo, area, fecha, recibidas, entregadas }) => (
      <li class="ficha__etapa" data-ficha-etapa data-codigo={codigo} data-entregadas={entregadas}>
        <span class="ficha__marca" aria-hidden="true" />
        <span class="ficha__area">
          <strong>{codigo}</strong>
          {area}
        </span>
        <span class="ficha__fecha">{fecha}</span>
        <span class="ficha__piezas">
          {entregadas}/{recibidas}
          {recibidas > entregadas && <em>−{recibidas - entregadas}</em>}
        </span>
      </li>
    ))}
  </ol>

  <footer class="ficha__pie">
    <span>Piezas buenas</span>
    <strong data-ficha-piezas>46</strong>
  </footer>
</figure>

<style>
  .ficha {
    --avance: 1;
    margin: 0;
    padding: 20px;
    background: var(--ap-superficie);
    border: 1px solid var(--q-dark);
    border-radius: 12px;
    box-shadow: 8px 8px 0 var(--q-dark);
    color: var(--q-dark);
  }

  .ficha__encabezado {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .ficha__encabezado div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ficha__codigo {
    font-family: var(--fuente-codigo);
    font-size: 15px;
    font-weight: 600;
  }

  .ficha__producto {
    font-size: 13px;
    color: var(--ap-texto-secundario);
  }

  .ficha__estado {
    padding: 2px 10px;
    border-radius: 999px;
    background: #dcfce7;
    font-size: 12px;
    font-weight: 500;
    line-height: 20px;
    color: var(--q-positive);
    white-space: nowrap;
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }

  .ficha__estado.en-proceso {
    background: #ffedd5;
    color: var(--q-primary);
  }

  .ficha__avance {
    height: 4px;
    margin: 16px 0 8px;
    border-radius: 2px;
    background: var(--ap-borde);
    overflow: hidden;
  }

  .ficha__avance span {
    display: block;
    height: 100%;
    background: var(--q-primary);
    transform: scaleX(var(--avance));
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .ficha__etapas {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ficha__etapa {
    display: grid;
    grid-template-columns: 16px 1fr auto 56px;
    align-items: center;
    gap: 12px;
    margin: 0 -8px;
    padding: 9px 8px;
    border-bottom: 1px solid var(--ap-borde);
    border-radius: 6px;
    font-size: 13px;
    transition:
      opacity 0.3s ease,
      background 0.3s ease;
  }

  .ficha__marca {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--q-positive);
    box-shadow: inset 0 0 0 2px var(--q-positive);
    transition:
      background 0.3s ease,
      box-shadow 0.3s ease;
  }

  .ficha__etapa.pendiente {
    opacity: 0.35;
  }

  .ficha__etapa.pendiente .ficha__marca {
    background: transparent;
    box-shadow: inset 0 0 0 2px #94a3b8;
  }

  .ficha__etapa.actual {
    background: #fff7ed;
  }

  .ficha__etapa.actual .ficha__marca {
    background: var(--q-accent);
    box-shadow: 0 0 0 4px rgb(249 115 22 / 25%);
  }

  .ficha__area {
    display: flex;
    gap: 8px;
    color: var(--ap-texto-secundario);
  }

  .ficha__area strong {
    width: 32px;
    font-family: var(--fuente-codigo);
    font-weight: 600;
    color: var(--q-dark);
  }

  .ficha__fecha {
    font-size: 12px;
    color: #64748b;
  }

  .ficha__piezas {
    font-family: var(--fuente-codigo);
    font-weight: 600;
    text-align: right;
  }

  .ficha__piezas em {
    display: block;
    font-size: 11px;
    font-style: normal;
    color: var(--q-primary);
  }

  .ficha__pie {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-top: 14px;
    font-size: 13px;
    color: var(--ap-texto-secundario);
  }

  .ficha__pie strong {
    font-family: var(--fuente-titulos);
    font-size: 32px;
    line-height: 1;
    color: var(--q-dark);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 599px) {
    .ficha {
      box-shadow: 4px 4px 0 var(--q-dark);
    }

    .ficha__etapa {
      grid-template-columns: 16px 1fr 56px;
    }

    .ficha__fecha {
      display: none;
    }
  }
</style>
