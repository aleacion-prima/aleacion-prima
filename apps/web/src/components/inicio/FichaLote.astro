---
const etapas = [
  { codigo: 'MOL', area: 'Moldeo', fecha: '24 sep 07:00', recibidas: 50, entregadas: 50 },
  { codigo: 'FUS', area: 'Fusión', fecha: '24 sep 10:30', recibidas: 50, entregadas: 50 },
  { codigo: 'COL', area: 'Colada', fecha: '24 sep 12:30', recibidas: 50, entregadas: 50 },
  { codigo: 'DES', area: 'Desmolde', fecha: '25 sep 07:00', recibidas: 50, entregadas: 48 },
  { codigo: 'GRA', area: 'Granallado', fecha: '25 sep 08:30', recibidas: 48, entregadas: 47 },
  { codigo: 'CAL', area: 'Calidad', fecha: '25 sep 10:30', recibidas: 47, entregadas: 46 },
];
---

<figure class="ficha" aria-label="Ejemplo de la trazabilidad de un lote">
  <header class="ficha__encabezado">
    <div>
      <span class="ficha__codigo">LOT-20260924-01</span>
      <span class="ficha__producto">Disco de freno · 50 piezas</span>
    </div>
    <span class="ficha__estado">Terminado</span>
  </header>

  <div class="ficha__avance" aria-hidden="true">
    <span></span>
  </div>

  <ol class="ficha__etapas">
    {etapas.map(({ codigo, area, fecha, recibidas, entregadas }, i) => (
      <li class="ficha__etapa" style={`--i: ${i}`}>
        <span class="ficha__marca" aria-hidden="true" />
        <span class="ficha__area">
          <strong>{codigo}</strong>
          {area}
        </span>
        <span class="ficha__fecha">{fecha}</span>
        <span class="ficha__piezas">
          {entregadas}/{recibidas}
          {recibidas > entregadas && <em>−{recibidas - entregadas}</em>}
        </span>
      </li>
    ))}
  </ol>

  <footer class="ficha__pie">
    <span>Piezas terminadas</span>
    <strong>46</strong>
  </footer>
</figure>

<style>
  .ficha {
    margin: 0;
    padding: 20px;
    background: var(--ap-superficie);
    border-radius: 12px;
    box-shadow:
      0 2px 4px rgb(0 0 0 / 20%),
      0 24px 48px -12px rgb(0 0 0 / 50%);
    color: var(--q-dark);
    text-align: left;
  }

  .ficha__encabezado {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .ficha__encabezado div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ficha__codigo {
    font-family: var(--fuente-codigo);
    font-size: 15px;
    font-weight: 600;
  }

  .ficha__producto {
    font-size: 13px;
    color: var(--ap-texto-secundario);
  }

  .ficha__estado {
    padding: 2px 10px;
    border-radius: 999px;
    background: #dcfce7;
    font-size: 12px;
    font-weight: 500;
    line-height: 20px;
    color: var(--q-positive);
  }

  .ficha__avance {
    height: 4px;
    margin: 16px 0 8px;
    border-radius: 2px;
    background: var(--ap-borde);
    overflow: hidden;
  }

  .ficha__avance span {
    display: block;
    height: 100%;
    background: var(--q-primary);
    transform-origin: left;
  }

  .ficha__etapas {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ficha__etapa {
    display: grid;
    grid-template-columns: 16px 1fr auto 64px;
    align-items: center;
    gap: 12px;
    padding: 9px 0;
    border-bottom: 1px solid var(--ap-borde);
    font-size: 13px;
  }

  .ficha__marca {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--q-positive);
    box-shadow: inset 0 0 0 2px var(--q-positive);
  }

  .ficha__area {
    display: flex;
    gap: 8px;
    color: var(--ap-texto-secundario);
  }

  .ficha__area strong {
    width: 32px;
    font-family: var(--fuente-codigo);
    font-weight: 600;
    color: var(--q-dark);
  }

  .ficha__fecha {
    font-size: 12px;
    color: #64748b;
  }

  .ficha__piezas {
    font-family: var(--fuente-codigo);
    font-weight: 600;
    text-align: right;
  }

  .ficha__piezas em {
    display: block;
    font-size: 11px;
    font-style: normal;
    color: var(--q-primary);
  }

  .ficha__pie {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-top: 14px;
    font-size: 13px;
    color: var(--ap-texto-secundario);
  }

  .ficha__pie strong {
    font-family: var(--fuente-titulos);
    font-size: 28px;
    line-height: 1;
    color: var(--q-dark);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ficha__avance span {
      animation: avanzar 3.6s cubic-bezier(0.4, 0, 0.2, 1) 0.6s backwards;
    }

    .ficha__etapa {
      animation: registrar 0.4s ease backwards;
      animation-delay: calc(0.6s + var(--i) * 0.6s);
    }

    .ficha__marca {
      animation: completar 0.4s ease backwards;
      animation-delay: calc(0.75s + var(--i) * 0.6s);
    }

    .ficha__estado,
    .ficha__pie strong {
      animation: aparecer 0.4s ease 4.2s backwards;
    }
  }

  @keyframes avanzar {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes registrar {
    from {
      opacity: 0.25;
    }
  }

  @keyframes completar {
    from {
      background: transparent;
      box-shadow: inset 0 0 0 2px var(--ap-borde);
    }
  }

  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 599px) {
    .ficha__etapa {
      grid-template-columns: 16px 1fr 56px;
    }

    .ficha__fecha {
      display: none;
    }
  }
</style>
