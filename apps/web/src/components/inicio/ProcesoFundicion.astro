---
const etapas = [
  { codigo: 'MOL', nombre: 'Moldeo', detalle: 'Moldes en arena verde, 80 % reciclada.' },
  {
    codigo: 'FUS',
    nombre: 'Fusión',
    detalle: 'Horno de inducción de 750 kg y ajuste metalúrgico.',
  },
  { codigo: 'COL', nombre: 'Colada', detalle: 'Inoculación en cuchara y enfriamiento en caja.' },
  { codigo: 'DES', nombre: 'Desmolde', detalle: 'Separación de piezas, canales y mazarotas.' },
  { codigo: 'GRA', nombre: 'Granallado', detalle: 'Limpieza con granalla de acero y rebabeo.' },
  { codigo: 'CAL', nombre: 'Calidad', detalle: 'Dureza Brinell, espectrometría y ultrasonido.' },
];
---

<section id="proceso" class="bloque proceso">
  <header class="bloque__encabezado" data-revelar>
    <div>
      <h2>Cómo fabricamos</h2>
      <p>Cada lote es una colada. En cada etapa se registran piezas, mermas e imprevistos.</p>
    </div>
  </header>
  <ol class="etapas" data-revelar>
    {etapas.map(({ codigo, nombre, detalle }, i) => (
      <li class="etapa" style={`--i: ${i}`}>
        <span class="etapa__numero">{String(i + 1).padStart(2, '0')}</span>
        <h3>
          {nombre} <span>{codigo}</span>
        </h3>
        <p>{detalle}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .proceso {
    background: var(--ap-superficie);
    border-top: 1px solid var(--ap-borde);
    border-bottom: 1px solid var(--ap-borde);
    scroll-margin-top: 0;
  }

  .etapas {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .etapa {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 20px 4px 0;
    border-top: 2px solid var(--ap-borde);
  }

  .etapa::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--q-primary);
    transform-origin: left;
  }

  .etapa__numero {
    font-family: var(--fuente-titulos);
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
    color: var(--ap-borde);
    transition: color 0.3s ease;
  }

  .etapa:hover .etapa__numero {
    color: var(--q-primary);
  }

  h3 {
    margin: 0;
    font-family: var(--fuente-titulos);
    font-size: 22px;
    font-weight: 600;
    line-height: 26px;
  }

  h3 span {
    font-family: var(--fuente-codigo);
    font-size: 12px;
    font-weight: 600;
    color: var(--ap-texto-secundario);
  }

  p {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--ap-texto-secundario);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.con-animaciones) .etapa::before {
      transform: scaleX(0);
    }

    .etapas:global(.revelado) .etapa::before {
      transform: none;
      transition: transform 0.45s ease-out calc(var(--i) * 0.35s);
    }

    .etapas:global(.revelado) .etapa__numero {
      animation: marcar 0.9s ease calc(var(--i) * 0.35s + 0.2s);
    }
  }

  @keyframes marcar {
    40% {
      color: var(--q-primary);
    }
  }

  @media (max-width: 1023px) {
    .etapas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 32px;
    }
  }

  @media (max-width: 599px) {
    .etapas {
      grid-template-columns: 1fr;
      row-gap: 24px;
    }
  }
</style>
