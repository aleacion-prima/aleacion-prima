---
import EncabezadoBloque from './EncabezadoBloque.astro';

const etapas = [
  {
    codigo: 'MOL',
    nombre: 'Moldeo',
    detalle: 'Mezcla de arena verde, 80 % reciclada, y un molde por pieza en la línea de cajas.',
  },
  {
    codigo: 'FUS',
    nombre: 'Fusión',
    detalle:
      'Horno de inducción de 750 kg. Carga de chatarra de fundición, acero 1020 y ferroaleaciones.',
  },
  {
    codigo: 'COL',
    nombre: 'Colada',
    detalle: 'Inoculación en cuchara, vaciado y enfriamiento en caja.',
  },
  {
    codigo: 'DES',
    nombre: 'Desmolde',
    detalle: 'Separación de piezas. Canales y mazarotas regresan al horno como retorno.',
  },
  {
    codigo: 'GRA',
    nombre: 'Granallado',
    detalle: 'Limpieza con granalla de acero y rebabeo con esmeril.',
  },
  {
    codigo: 'CAL',
    nombre: 'Calidad',
    detalle: 'Dureza Brinell, espectrometría y ultrasonido antes de liberar el lote.',
  },
];
---

<section id="proceso" class="bloque">
  <EncabezadoBloque
    numero="02"
    titulo="De la arena a la entrega"
    texto="Cada lote es una colada. En cada etapa se registran piezas recibidas, entregadas y mermas."
  />
  <ol class="operaciones">
    {etapas.map(({ codigo, nombre, detalle }, i) => (
      <li class="operacion" data-revelar style={`--i: ${i}`}>
        <span class="operacion__numero">{String(i + 1).padStart(2, '0')}</span>
        <h3>{nombre}</h3>
        <span class="operacion__codigo">{codigo}</span>
        <p>{detalle}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .operaciones {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .operacion {
    position: relative;
    display: grid;
    grid-template-columns: 96px 220px 64px minmax(0, 1fr);
    align-items: center;
    min-height: 72px;
    border-bottom: 1px solid #cbd5e1;
    transition: background 0.2s ease;
  }

  .operacion::before {
    content: '';
    position: absolute;
    inset: -1px auto -1px 0;
    width: 4px;
    background: var(--q-primary);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.25s ease;
  }

  .operacion:hover {
    background: var(--ap-superficie);
  }

  .operacion:hover::before {
    transform: none;
  }

  .operacion__numero {
    align-self: stretch;
    display: flex;
    align-items: center;
    border-right: 1px solid #cbd5e1;
    font-family: var(--fuente-titulos);
    font-size: 34px;
    font-weight: 700;
    color: #94a3b8;
    padding-left: 20px;
    transition: color 0.2s ease;
  }

  .operacion:hover .operacion__numero {
    color: var(--q-primary);
  }

  h3 {
    padding: 0 24px;
    font-size: 26px;
    font-weight: 700;
    line-height: 28px;
    text-transform: uppercase;
  }

  .operacion__codigo {
    font-family: var(--fuente-codigo);
    font-size: 13px;
    font-weight: 600;
    color: var(--q-primary);
  }

  p {
    margin: 0;
    padding: 16px 24px 16px 0;
    font-size: 15px;
    line-height: 22px;
    color: var(--ap-texto-secundario);
  }

  @media (max-width: 899px) {
    .operacion {
      grid-template-columns: 64px minmax(0, 1fr) auto;
      grid-template-areas:
        'numero nombre codigo'
        'numero detalle detalle';
      padding: 16px 0;
    }

    .operacion__numero {
      grid-area: numero;
      padding-left: 12px;
      font-size: 26px;
    }

    h3 {
      grid-area: nombre;
      padding: 0 16px;
      font-size: 22px;
    }

    .operacion__codigo {
      grid-area: codigo;
      padding-right: 16px;
    }

    p {
      grid-area: detalle;
      padding: 6px 16px 0;
    }
  }
</style>
