---
import { PUBLIC_PANEL_URL } from 'astro:env/client';

interface Props {
  seccion?: 'inicio' | 'catalogo';
}

const { seccion } = Astro.props;
---

<header class="barra">
  <div class="barra__contenido">
    <a class="barra__logo" href="/">
      ALEACIÓN PRIMA
    </a>

    <nav class="barra__nav" aria-label="Navegación principal">
      <a href="/" class:list={['barra__enlace', { 'barra__enlace--activo': seccion === 'inicio' }]}>
        Inicio
      </a>
      <a
        href="/catalogo"
        class:list={['barra__enlace', { 'barra__enlace--activo': seccion === 'catalogo' }]}
      >
        Catálogo
      </a>
    </nav>

    <a class="barra__acceso" href={`${PUBLIC_PANEL_URL}/login`}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0"
        />
      </svg>
      Iniciar sesión
    </a>
  </div>
</header>

<style>
  .barra {
    background: var(--q-secondary);
  }

  .barra__contenido {
    align-items: center;
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr auto 1fr;
    margin: 0 auto;
    max-width: 1440px;
    min-height: 64px;
    padding: 0 32px;
  }

  .barra__logo {
    color: var(--ap-superficie);
    font-family: var(--fuente-titulos);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .barra__nav {
    display: flex;
    gap: 32px;
    height: 64px;
  }

  .barra__enlace {
    align-items: center;
    border-bottom: 2px solid transparent;
    color: var(--ap-borde);
    display: flex;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    padding: 0 2px;
    text-decoration: none;
  }

  .barra__enlace:hover {
    color: var(--ap-superficie);
  }

  .barra__enlace--activo {
    border-bottom-color: var(--q-accent);
    color: var(--ap-superficie);
  }

  .barra__acceso {
    align-items: center;
    color: var(--ap-borde);
    display: flex;
    font-size: 14px;
    font-weight: 500;
    gap: 8px;
    justify-self: end;
    line-height: 20px;
    text-decoration: none;
  }

  .barra__acceso:hover {
    color: var(--ap-superficie);
  }

  @media (max-width: 720px) {
    .barra__contenido {
      gap: 16px;
      grid-template-columns: auto 1fr;
      padding: 0 16px;
    }

    .barra__nav {
      gap: 20px;
      justify-self: center;
    }

    .barra__acceso {
      grid-column: 1 / -1;
      justify-self: center;
      padding-bottom: 12px;
    }
  }
</style>
