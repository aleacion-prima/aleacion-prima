# ─── Aplicación ──────────────────────────────────────────────
APP_NAME="Aleación Prima"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

# artisan serve atiende una petición a la vez
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── PostgreSQL (contenedor "postgres" de compose.yaml) ──────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=aleacion_prima
DB_USERNAME=aleacion
DB_PASSWORD=aleacion
# En integración (Neon) va en "require"; ver docs/bases-de-datos.md
DB_SSLMODE=prefer

# ─── MongoDB (contenedor "mongo" de compose.yaml) ────────────
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=aleacion_prima

# ─── Sesión, Sanctum y CORS ──────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:9000
# Panel, sitio y app Android (Capacitor)
CORS_ALLOWED_ORIGINS=http://localhost:9000,http://localhost:4321,https://localhost

# ─── Reverb (llaves fijas SOLO para desarrollo) ──────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=aleacion
REVERB_APP_KEY=aleacion-local
REVERB_APP_SECRET=aleacion-local-secret
# Desde la API hacia el contenedor "reverb"
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Reverb compara solo el host, sin protocolo ni puerto
REVERB_ALLOWED_ORIGINS=localhost

# ─── Colas, caché y archivos ─────────────────────────────────
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ─── Correo (en desarrollo solo se escribe en el log) ────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@aleacionprima.local"
MAIL_FROM_NAME="${APP_NAME}"


# Constantes de planta (opcionales; los valores por defecto están en config/planta.php)
# PLANTA_UMBRAL_CAPTURA_TARDIA=30
# PLANTA_CAPACIDAD_COLADA_KG=750
# PLANTA_INSUMO_RETORNO=CHT-FUN