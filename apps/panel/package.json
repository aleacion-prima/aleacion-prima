{
  "name": "panel",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "panel",
  "author": "cesar <cesarmorillon576@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "lint": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "lint:check": "prettier \"**/*.{js,ts,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "dev:android": "quasar dev -m capacitor -T android",
    "build:android": "quasar build -m capacitor -T android"
  },
  "dependencies": {
    "@aleacion-prima/types": "workspace:*",
    "@quasar/extras": "^2.1.0",
    "@vueuse/core": "^15.0.0",
    "laravel-echo": "^2.5.0",
    "pinia": "^4.0.2",
    "pusher-js": "^8.6.0",
    "qrcode.vue": "3.11.0",
    "quasar": "^2.33.0",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.9.0",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
